	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.macwsguide.host</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>macwshost</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
