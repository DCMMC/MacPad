<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- cfprefsd is a root daemon and must not be assigned an iOS app or
	     system container.  The generic MacWS GPU profile contains
	     com.apple.security.system-container, which runtime-confirmed makes
	     iPadOS sandbox kill this chroot executable before main(). -->
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<!-- Persistent marker used by macos_gui.sh's cold-start signature
	     sentinel.  This is also already present in the generic profile. -->
	<key>com.apple.private.graphics-restart-no-kill</key>
	<true/>
	<!-- Required for dyld to map the separately signed, trustcached
	     DYLD_INSERT_LIBRARIES image before libmachook itself can run. -->
	<key>com.apple.private.amfi.can-execute-cdhash</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
	<key>platform-application</key>
	<true/>
</dict>
</plist>
