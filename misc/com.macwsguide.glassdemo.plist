<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macwsguide.glassdemo</string>

    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/macOS/bin/launchdchrootexec</string>
        <string>0</string>
        <string>0</string>
        <string>/var/mnt/rootfs</string>
        <string>/tmp/GlassDemo</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CA_DISABLE_SWAP_ICC</key>
        <string>1</string>
        <key>CA_VSYNC_OFF</key>
        <string>1</string>
        <key>MACWS_AGX_NATIVE</key>
        <string>1</string>
        <key>MACWS_AGX_REGISTER_CLASSES</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/var/jb/var/mobile/glassdemo-native.log</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/var/mobile/glassdemo-native.log</string>
</dict>
</plist>
