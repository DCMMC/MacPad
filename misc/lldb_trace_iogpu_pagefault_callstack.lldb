# Runtime address is the original IMP printed by IOGPU-CALLBACK-DIAG for
# WindowServer PID 43831.  Refresh it after the shared-cache slide changes.
# Current witness: orig=0x1b39e2be8, Code is the uint64_t at NSError+0x10.
breakpoint set --address 0x1b39e2be8 --condition '$x4 != 0 && *(unsigned long long *)($x4 + 0x10) == 3'
continue
register read x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 x29 x30 pc sp
memory read --format x --size 8 --count 16 '$x4'
memory read --format x --size 8 --count 12 '$x0+0x248'
thread backtrace -c 60
frame select 2
register read pc fp lr sp
disassemble --frame --count 96
frame select 3
register read pc fp lr sp
disassemble --frame --count 96
