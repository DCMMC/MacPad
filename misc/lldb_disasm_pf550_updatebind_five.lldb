settings set target.memory-module-load-level minimal
settings set target.process.stop-on-sharedlibrary-events true
command script import misc/lldb_trace_pf550_updatebind.py
process handle -s false -n false -p false SIGSTOP
script lldb_trace_pf550_updatebind.wait_for_agx_and_install_five(lldb.debugger)
settings set target.process.stop-on-sharedlibrary-events false
process handle -s false -n false -p true SIGSEGV SIGBUS
script lldb_trace_pf550_updatebind.continue_until_target(lldb.debugger)
register read x0 x1 x2 x3 x4 x5 x6 x7 x8 x19 x20 x21 x22 x23 x24 lr pc
script lldb_trace_pf550_updatebind.dump_target_impl(lldb.debugger, "five-arg-entry")
thread backtrace
disassemble --start-address $lr-160 --count 112
disassemble --start-address $pc --count 420
