settings set target.process.stop-on-sharedlibrary-events false
command script import misc/lldb_trace_iosclear_iogpu.py
script lldb_trace_iosclear_iogpu.install_submit_only(lldb.debugger)
continue
register read x0 x1 x2 x3 x4 x5
thread backtrace
script lldb_trace_iosclear_iogpu.print_summary()
script exec(open("misc/lldb_dump_iosclear.py").read())
detach
quit
