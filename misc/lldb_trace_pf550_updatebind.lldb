settings set target.process.stop-on-sharedlibrary-events false
command script import misc/lldb_trace_pf550_updatebind.py
script lldb_trace_pf550_updatebind.install(lldb.debugger)
continue
register read x0 x1 x2 x3 x4 x5 x6 lr pc
thread backtrace
script lldb_trace_pf550_updatebind.arm_after_update(lldb.debugger)
continue
register read x0 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 lr pc
script lldb_trace_pf550_updatebind.dump_impl_from_x24(lldb.debugger, "after-store")
script lldb_trace_pf550_updatebind.arm_compressible_virtual_call(lldb.debugger)
continue
register read x0 x8 x16 x17 x24 lr pc
thread step-inst
register read x0 x8 x16 x17 x24 lr pc
thread backtrace
disassemble --start-address $pc --count 360
